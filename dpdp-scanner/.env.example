# Copy to .env (or set these as real secrets in your hosting platform —
# fly secrets set / Railway's Variables tab). Never commit a real .env.
# Every value below has a safe default if left unset — see app/config.py,
# app/auth.py, app/logging_setup.py for the exact fallback behavior.

# --- Dashboard auth (app/auth.py) --------------------------------------
# REQUIRED before this is reachable by anyone but you — see DEPLOY.md's
# security section. These seed only the FIRST operator on a brand-new DB
# (see app/auth.py:seed_operator_from_env) — after that, add/deactivate
# operators via the dashboard's /operators page or
# scripts/manage_operators.py. Leaving both unset disables auth entirely
# (loudly: a warning banner renders on every page and a warning logs on
# startup).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-something-real
# Alternative to DASHBOARD_PASSWORD: a pre-hashed password (werkzeug
# generate_password_hash output) if you'd rather not put a plaintext
# password in an env var manager at all. Set at most one of the two.
# DASHBOARD_PASSWORD_HASH=
# Signs CSRF tokens AND the client portal's session cookie (app/portal.py)
# — set this in any real deployment. Falls back to a random per-process
# value if unset, which means every restart/redeploy invalidates every
# in-flight CSRF token AND logs every client out of their portal session.
# SECRET_KEY=
# Set to 1 once the app is served over HTTPS (Fly/Railway both terminate
# TLS in front of the app, so this needs to be turned on explicitly — see
# app/config.py). Leave 0 for local/plain-HTTP development.
# SESSION_COOKIE_SECURE=0

# --- Classifier (app/agents/classifier.py) ------------------------------
# Leave unset to use the deterministic rule-based mock classifier.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_RETRIES=3
# GEMINI_TIMEOUT_SECONDS=30
# MAX_ITEMS_PER_PAGE_FOR_CLASSIFIER=60

# --- WhatsApp sending (app/agents/notifier.py) ---------------------------
# All three required together to enable real sending — otherwise alerts
# simulate (logged + dashboard-only). TWILIO_WHATSAPP_FROM is your
# Twilio-provisioned WhatsApp sender, e.g. "whatsapp:+14155238886" for the
# Twilio sandbox number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# WHATSAPP_SEND_MAX_RETRIES=2

# --- Crawler (app/agents/crawler.py) --------------------------------------
# MAX_CRAWL_DEPTH=2
# MAX_PAGES=25
# CRAWL_DELAY_SECONDS=1.0
# REQUEST_TIMEOUT_MS=15000
# Leave OFF in every real deployment. Only needed for local fixture-site
# testing (tests/fixture_site via http://localhost:8899/, see README) —
# without it, crawling any private/loopback/link-local address is refused
# as a likely SSRF target.
# ALLOW_PRIVATE_CRAWL_TARGETS=0

# --- Ops self-check (app/ops.py) ------------------------------------------
# STALE_SCAN_THRESHOLD_DAYS=10
# CONSECUTIVE_FAILURE_WINDOW=3

# --- Logging / error tracking (app/logging_setup.py) ----------------------
# LOG_LEVEL=INFO
# LOG_FILE=            # unset = stdout only (correct for Fly/Railway)
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_BACKUP_COUNT=5
# SENTRY_DSN=          # requires sentry-sdk installed — see requirements.txt

# --- Flask dev server only (never set in production hosting) --------------
# FLASK_DEBUG=0
# PORT=5000
